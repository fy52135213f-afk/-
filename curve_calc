def _ask(prompt: str, default=None):
    hint = f"（默认 {default}）" if default is not None else ""
    raw = input(f"  {prompt}{hint}: ").strip()
    if not raw and default is not None:
        return str(default)
    return raw


def _ask_float(prompt: str, default=None, min_val=None) -> float:
    while True:
        try:
            raw = _ask(prompt, default)
            val = float(raw)
            if min_val is not None and val < min_val:
                print(f"    ⚠ 必须 ≥ {min_val}，请重新输入")
                continue
            return val
        except ValueError:
            print("    ⚠ 请输入有效数字")
        except EOFError:
            sys.exit(0)


def _ask_int(prompt: str, default=None) -> int:
    while True:
        try:
            raw = _ask(prompt, default)
            return int(raw)
        except ValueError:
            print("    ⚠ 请输入整数")
        except EOFError:
            sys.exit(0)


