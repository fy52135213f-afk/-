def calculate(inp: dict) -> dict:
    """
    按教材公式完成全部计算，返回结果字典

    【v2 修正内容 — 方位角来源】
    ─────────────────────────────────────────────────────────────────────────
    旧：az_ZH_JD = azimuth(Xa, Ya, Xjd, Yjd)   ← 用 A→JD 方位角（错误）
    新：az_ZH_JD = inp['az_AB']                  ← 用 A→B 方位角（正确）

    原因：
    · A、B 是实测控制点，A→B 严格代表入线切线方向；
    · JD1 坐标是设计值，与 A/B 未必精确共线；
    · 局部坐标系的 x' 轴方向由入线切线确定，与 JD1 无关；
    · JD1 仅用于由切线长 T 反推 ZH/HZ 大地坐标（步骤④后半段）。

    计算流程（步骤编号与原版一致）：
    ① 缓和曲线基础常数（C、β0、m、p）        ← 公式不变
    ② 曲线综合要素（T、L、Ly、E0、q）         ← 公式不变
    ③ 主点里程（全部由 DK_ZH 推算）           ← 公式不变
    ④ 方位角（★修正来源） & ZH/HZ 大地坐标   ← 来源修正，推算逻辑不变
    ⑤ 主点局部坐标 & 大地坐标                 ← 公式不变
    ⑥ 直线段特殊点（每 50m，不含 ZH）         ← 规则不变
    ⑦ ZH→HY 缓和曲线特殊点（每 10m）         ← 规则不变
    ⑧ HY→YH 圆曲线特殊点（双向整20m桩）      ← 规则不变
    ⑨ YH→HZ 缓和曲线特殊点（每 10m）         ← 规则不变
    """
    Xa, Ya    = inp['Xa'],   inp['Ya']
    Xb, Yb    = inp['Xb'],   inp['Yb']
    Xjd1, Yjd1 = inp['Xjd1'], inp['Yjd1']  # ★ v2：JD → JD1
    alpha_deg  = inp['alpha_deg']
    sign       = inp['sign']
    R          = inp['R']
    l0         = inp['l0']
    DK_ZH      = inp['DK_ZH']

    alpha_rad = deg2rad(alpha_deg)

    # ─── ① 缓和曲线基础常数（教材标准公式，不做任何改动）───────────────────
    C         = R * l0
    beta0_rad = l0 / (2.0 * R)
    beta0_deg = rad2deg(beta0_rad)
    m_val     = l0 / 2.0 - l0**3 / (240.0 * R**2)
    p_val     = l0**2 / (24.0 * R)

    # ─── ② 曲线综合要素（教材标准公式，不做任何改动）───────────────────────
    T      = m_val + (R + p_val) * math.tan(alpha_rad / 2.0)
    L      = l0 + R * alpha_rad
    Ly     = L - 2.0 * l0
    E0     = (R + p_val) / math.cos(alpha_rad / 2.0) - R
    q_val  = 2.0 * T - L

    if Ly <= 1e-6:
        raise ValueError(
            f"圆曲线长 Ly = {Ly:.6f} m ≤ 0，缓和曲线过长！\n"
            f"  请减小 l0（当前 {l0} m）、增大 R（当前 {R} m）或增大 α（当前 {alpha_deg:.4f}°）。"
        )

    # ─── ③ 主点里程（全部由 DK_ZH 推算，不做任何改动）────────────────────
    DK_HY  = DK_ZH + l0
    DK_QZ  = DK_ZH + L / 2.0
    DK_YH  = DK_ZH + L - l0
    DK_HZ  = DK_ZH + L

    assert abs(DK_QZ - (DK_ZH + DK_HZ) / 2.0) < 1e-6, "QZ 里程校核失败"

    # ─── ④ 方位角 & ZH/HZ 大地坐标 ──────────────────────────────────────
    #
    # ★ v2 核心修正：
    #   az_ZH_JD（局部坐标系 x' 轴方位角）来自控制点 A→B，
    #   不再从 A→JD1 计算（两者仅在三点严格共线时相等）。
    #
    # 方位角含义梳理：
    #   az_ZH_JD  = A→B 方位角 = ZH→JD1 切线方向（入线方向）
    #   az_JD_ZH  = az_ZH_JD + π               （JD1→ZH，即入线反方向）
    #   az_JD_HZ  = az_ZH_JD + sign·α          （JD1→HZ，即出线方向）
    #   az_HZ_back= az_JD_HZ + π               （HZ→JD1，用于 YH→HZ 缓和曲线反向展开）
    #
    # 注意：sign·α 中 sign=+1（右偏）时出线方位角顺时针增大；
    #       sign=−1（左偏）时出线方位角逆时针减小（顺时针缩小）。
    # ─────────────────────────────────────────────────────────────────────

    az_ZH_JD  = inp['az_AB']                             # ★ 修正：来自 A→B，非 A→JD1
    az_JD_HZ  = normalize_az(az_ZH_JD + sign * alpha_rad)  # 出线方位角
    az_JD_ZH  = normalize_az(az_ZH_JD + PI)                # JD1→ZH（入线反方向）

    # ZH 坐标：从 JD1 沿入线反方向退 T（切线长）
    X_ZH = Xjd1 + T * math.cos(az_JD_ZH)
    Y_ZH = Yjd1 + T * math.sin(az_JD_ZH)

    # HZ 坐标：从 JD1 沿出线方向走 T（切线长）
    X_HZ = Xjd1 + T * math.cos(az_JD_HZ)
    Y_HZ = Yjd1 + T * math.sin(az_JD_HZ)

    # 控制点 A 里程（A 在 ZH 前方，DK_A < DK_ZH）
    dist_A_ZH = math.hypot(X_ZH - Xa, Y_ZH - Ya)
    DK_A = DK_ZH - dist_A_ZH

    # 控制点 B 里程（B 在入线切线上，A→B→ZH 方向）
    dist_A_B = math.hypot(Xb - Xa, Yb - Ya)
    DK_B     = DK_A + dist_A_B

    # ─── ⑤ 主点局部坐标 & 大地坐标（不做任何改动）────────────────────────
    loc_ZH = (0.0, 0.0)
    geo_ZH = (X_ZH, Y_ZH)

    loc_HY = hy_point_xy(l0, R)
    geo_HY = local_to_geodetic(loc_HY[0], loc_HY[1], X_ZH, Y_ZH, az_ZH_JD, sign)

    loc_QZ = circle_xy(L / 2.0, R, l0, beta0_rad, m_val, p_val)
    geo_QZ = local_to_geodetic(loc_QZ[0], loc_QZ[1], X_ZH, Y_ZH, az_ZH_JD, sign)

    loc_YH = circle_xy(L - l0, R, l0, beta0_rad, m_val, p_val)
    geo_YH = local_to_geodetic(loc_YH[0], loc_YH[1], X_ZH, Y_ZH, az_ZH_JD, sign)

    # HZ 局部坐标（反算：大地→局部，用于汇总表格局部坐标列）
    dX_HZ = X_HZ - X_ZH
    dY_HZ = Y_HZ - Y_ZH
    x_HZ_loc        = dX_HZ * math.cos(az_ZH_JD) + dY_HZ * math.sin(az_ZH_JD)
    y_HZ_loc_signed = -dX_HZ * math.sin(az_ZH_JD) + dY_HZ * math.cos(az_ZH_JD)
    y_HZ_loc        = y_HZ_loc_signed / sign
    loc_HZ = (x_HZ_loc, y_HZ_loc)
    geo_HZ = (X_HZ, Y_HZ)

    main_pts = {
        'ZH': {'DK': DK_ZH, 'loc': loc_ZH, 'geo': geo_ZH},
        'HY': {'DK': DK_HY, 'loc': loc_HY, 'geo': geo_HY},
        'QZ': {'DK': DK_QZ, 'loc': loc_QZ, 'geo': geo_QZ},
        'YH': {'DK': DK_YH, 'loc': loc_YH, 'geo': geo_YH},
        'HZ': {'DK': DK_HZ, 'loc': loc_HZ, 'geo': geo_HZ},
    }

    # ─── ⑥ 直线段特殊点（A→ZH，每 50m，不含 ZH，规则不变）────────────────
    straight_pts = []
    dk = math.ceil(DK_A / 50.0) * 50.0
    while dk < DK_ZH - 1e-6:
        d_to_zh = DK_ZH - dk
        X_pt = X_ZH - d_to_zh * math.cos(az_ZH_JD)
        Y_pt = Y_ZH - d_to_zh * math.sin(az_ZH_JD)
        x_pt_loc = dk - DK_ZH
        y_pt_loc = 0.0
        straight_pts.append({'DK': dk, 'loc': (x_pt_loc, y_pt_loc),
                              'X': X_pt, 'Y': Y_pt})
        dk += 50.0

    # ─── ⑦ ZH→HY 缓和曲线特殊点（每 10m，含 ZH、HY，规则不变）────────────
    zh_hy_pts = []
    for dk in _gen_mileages(DK_ZH, DK_HY, step=10.0):
        l = dk - DK_ZH
        x_p, y_p = spiral_xy(l, R, l0)
        X_p, Y_p = local_to_geodetic(x_p, y_p, X_ZH, Y_ZH, az_ZH_JD, sign)
        zh_hy_pts.append({'DK': dk, 'loc': (x_p, y_p), 'geo': (X_p, Y_p)})

    # ─── ⑧ HY→YH 圆曲线普通布点（双向整20m桩，不含HY/QZ/YH主点）──────────
    hy_yh_pts = []
    circle_dks_hy_side = []
    circle_dks_yh_side = []

    first_hy = math.ceil(DK_HY / 20.0) * 20.0
    if abs(first_hy - DK_HY) < 1e-6:
        first_hy += 20.0
    dk_iter = first_hy
    while dk_iter < DK_QZ - 1e-6:
        circle_dks_hy_side.append(round(dk_iter, 6))
        dk_iter += 20.0

    first_yh = math.floor(DK_YH / 20.0) * 20.0
    if abs(first_yh - DK_YH) < 1e-6:
        first_yh -= 20.0
    dk_iter = first_yh
    while dk_iter > DK_QZ + 1e-6:
        circle_dks_yh_side.append(round(dk_iter, 6))
        dk_iter -= 20.0

    all_circle_dks = sorted(set(circle_dks_hy_side) | set(circle_dks_yh_side))

    for dk in all_circle_dks:
        l = dk - DK_ZH
        x_p, y_p = circle_xy(l, R, l0, beta0_rad, m_val, p_val)
        X_p, Y_p = local_to_geodetic(x_p, y_p, X_ZH, Y_ZH, az_ZH_JD, sign)
        hy_yh_pts.append({'DK': dk, 'loc': (x_p, y_p), 'geo': (X_p, Y_p)})

    # ─── ⑨ YH→HZ 缓和曲线特殊点（每 10m，以 HZ 为原点反向，规则不变）──────
    #
    # 说明：YH→HZ 段缓和曲线以 HZ 为原点、HZ→JD1 反向为 x' 轴正向展开，
    #       故原点坐标用 (X_HZ, Y_HZ)，方位角用 az_HZ_back（HZ→JD1反向）。
    #       sign 取反（-sign）以保持偏转方向一致。
    #
    az_HZ_back = normalize_az(az_JD_HZ + PI)
    yh_hz_pts = []
    for dk in _gen_mileages(DK_YH, DK_HZ, step=10.0):
        l = DK_HZ - dk
        x_p, y_p = spiral_xy(l, R, l0)
        X_p, Y_p = local_to_geodetic(x_p, y_p, X_HZ, Y_HZ, az_HZ_back, -sign)
        yh_hz_pts.append({'DK': dk, 'loc': (x_p, y_p), 'geo': (X_p, Y_p)})

    return {
        'inp': inp,
        # ① 缓和曲线基础常数
        'C': C, 'beta0_rad': beta0_rad, 'beta0_deg': beta0_deg,
        'm': m_val, 'p': p_val,
        # ② 综合要素
        'T': T, 'L': L, 'Ly': Ly, 'E0': E0, 'q': q_val,
        # ③ 主点里程
        'DK_ZH': DK_ZH, 'DK_HY': DK_HY, 'DK_QZ': DK_QZ,
        'DK_YH': DK_YH, 'DK_HZ': DK_HZ,
        # ④ 方位角 & 坐标
        'az_ZH_JD': az_ZH_JD, 'az_JD_HZ': az_JD_HZ,
        'az_JD_ZH': az_JD_ZH, 'az_HZ_back': az_HZ_back,
        'X_ZH': X_ZH, 'Y_ZH': Y_ZH,
        'X_HZ': X_HZ, 'Y_HZ': Y_HZ,
        # ⑤ 主点坐标
        'main_pts': main_pts,
        # ⑥⑦⑧⑨ 特殊点
        'DK_A': DK_A, 'DK_B': DK_B,
        'straight_pts': straight_pts,
        'zh_hy_pts': zh_hy_pts,
        'hy_yh_pts': hy_yh_pts,
        'yh_hz_pts': yh_hz_pts,
        # 圆曲线双侧布点里程（供控制台核对）
        'circle_dks_hy_side': circle_dks_hy_side,
        'circle_dks_yh_side': circle_dks_yh_side,
    }


