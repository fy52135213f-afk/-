def dms_to_decimal(d: float, m: float, s: float) -> float:
    """度分秒 → 十进制度（结果非负）"""
    return abs(d) + abs(m) / 60.0 + abs(s) / 3600.0


def decimal_to_dms(deg: float) -> str:
    """十进制度 → 度分秒格式字符串（°′″）"""
    deg = abs(deg)
    d = int(deg)
    m_f = (deg - d) * 60
    m = int(m_f)
    s = (m_f - m) * 60
    return f"{d:d}°{m:02d}′{s:06.3f}″"


def deg2rad(d: float) -> float:
    return d * PI / 180.0


def rad2deg(r: float) -> float:
    return r * 180.0 / PI


def normalize_az(a: float) -> float:
    """坐标方位角归化至 [0, 2π)"""
    return a % (2 * PI)


def azimuth(X1: float, Y1: float, X2: float, Y2: float) -> float:
    """
    两点坐标方位角（弧度，[0, 2π)）
    测量坐标系：X=北，Y=东
    公式：α = atan2(ΔY, ΔX)（从北顺时针）
    """
    return normalize_az(math.atan2(Y2 - Y1, X2 - X1))


def fmt_mileage(K: float) -> str:
    """格式化里程：K1+234.567"""
    km = int(K // 1000)
    m = K - km * 1000
    return f"K{km}+{m:07.3f}"


def sep(char: str = '─', n: int = 76) -> str:
    return char * n


