# § CSV 导出（UTF-8 无BOM，新字段格式）
# ═════════════════════════════════════════════════════════════════════════════

def export_csv(unique_rows: list, res: dict, filename: str = 'curve_data.csv'):
    """
    导出 curve_data.csv
    ─────────────────────────────────────────────────────────────────────────
    编码：UTF-8 无BOM（禁止 utf-8-sig，MATLAB R2024b detectImportOptions 可直接读取）

    固定字段：里程,点类型,局部x,局部y,大地X,大地Y,分类

    分类标签规则（5种，MATLAB 颜色区分）：
      · 线路控制点  — 直线起点A、直线终点B（从 CSV 读取，不再硬编码）
      · 直线段      — 入线直线段 50m 布点
      · 缓和曲线    — ZH→HY、YH→HZ 缓和曲线 10m 布点
      · 圆曲线      — HY→YH 双向整20m桩布点
      · 主点        — ZH、HY、QZ、YH、HZ
    """
    MAIN_KEYS = {'ZH', 'HY', 'QZ', 'YH', 'HZ'}

    SEG_LABEL = {
        '线路控制点': '线路控制点',
        '直线段':     '直线段',
        '缓和曲线':   '缓和曲线',
        '圆曲线':     '圆曲线',
        '主点':       '主点',
    }

    script_dir = os.path.dirname(os.path.abspath(__file__))
    filepath   = os.path.join(script_dir, filename)

    with open(filepath, 'w', newline='', encoding='utf-8') as f:
        writer = csv.writer(f)
        writer.writerow(['里程', '点类型', '局部x', '局部y', '大地X', '大地Y', '分类'])
        for row in unique_rows:
            seg   = row.get('seg', '')
            label = SEG_LABEL.get(seg, seg)
            writer.writerow([
                f"{row['DK']:.4f}",
                row['typ'],
                f"{row['xp']:.6f}",
                f"{row['yp']:.6f}",
                f"{row['X']:.6f}",
                f"{row['Y']:.6f}",
                label,
            ])

    count_map = defaultdict(int)
    for row in unique_rows:
        count_map[SEG_LABEL.get(row.get('seg', ''), '其他')] += 1

    print(f"  ✔ CSV 已导出：{filepath}")
    print(f"    共 {len(unique_rows)} 行，编码：UTF-8（无BOM）")
    print(f"    字段：里程, 点类型, 局部x, 局部y, 大地X, 大地Y, 分类")
    print(f"    分类统计：", end='')
    for lbl, cnt in sorted(count_map.items()):
        print(f"  {lbl}={cnt}", end='')
    print()
    print()


