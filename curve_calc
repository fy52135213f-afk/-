# § 核心公式函数（local_to_geodetic 函数体完全不改动，已验证正确）
# ═════════════════════════════════════════════════════════════════════════════

def local_to_geodetic(x_prime: float, y_prime: float,
                      X0: float, Y0: float,
                      az: float, sign: int) -> tuple:
    """
    局部坐标 → 大地坐标（测量坐标系）
    教材旋转平移矩阵公式：
      [X]   [cos az   −sin az] [ x'  ]   [X0]
      [Y] = [sin az    cos az] [±y'  ] + [Y0]
    其中 ±y' = sign × y'（右偏 sign=+1，左偏 sign=−1）

    参数说明：
      x_prime, y_prime — 局部坐标系坐标（ZH 为原点，ZH→JD1 为 x' 轴正方向）
      X0, Y0           — 原点（ZH 或 HZ 点）的大地坐标
      az               — 局部坐标系 x' 轴的坐标方位角（弧度）
                         ★ 必须用 A→B 反算结果，不得用转角 α！
      sign             — 偏转符号（右偏+1 / 左偏−1）

    【函数体完全不改动，已通过方向向量验证】
    """
    y_s = sign * y_prime
    X = X0 + x_prime * math.cos(az) - y_s * math.sin(az)
    Y = Y0 + x_prime * math.sin(az) + y_s * math.cos(az)
    return X, Y


def spiral_xy(l: float, R: float, l0: float) -> tuple:
    """
    缓和曲线局部坐标（ZH 为原点，ZH→JD1 为 x' 轴）
    教材实用简化公式（令 C = R·l0）：
      x = l − l⁵ / (40·R²·l0²)
      y = l³ / (6·R·l0)
    参数：l — 计算点到 ZH（或 HZ）的缓和曲线弧长，l ∈ [0, l0]
    """
    if abs(l) < 1e-12:
        return 0.0, 0.0
    x = l - l**5 / (40.0 * R**2 * l0**2)
    y = l**3 / (6.0 * R * l0)
    return x, y


def hy_point_xy(l0: float, R: float) -> tuple:
    """
    HY 点（令 l = l0）专用坐标公式
    教材专用公式：
      x0 = l0 − l0³ / (40·R²)
      y0 = l0² / (6·R)
    """
    x0 = l0 - l0**3 / (40.0 * R**2)
    y0 = l0**2 / (6.0 * R)
    return x0, y0


def circle_xy(l: float, R: float, l0: float,
              beta0_rad: float, m: float, p: float) -> tuple:
    """
    圆曲线段局部坐标（ZH 为原点，ZH→JD1 为 x' 轴）
    教材公式：
      φ = (l − l0)/R + β0        （圆心角，弧度）
      x = R·sin(φ) + m
      y = R·(1 − cos(φ)) + p
    参数：l — 计算点到 ZH 点的总弧长，l ∈ [l0, L−l0]
    """
    phi = (l - l0) / R + beta0_rad
    x = R * math.sin(phi) + m
    y = R * (1.0 - math.cos(phi)) + p
    return x, y


def _gen_mileages(dk_start: float, dk_end: float, step: float) -> list:
    """
    生成里程列表，必须包含起终点（dk_start, dk_end）
    中间按 step 步长生成 step 整倍数桩
    """
    result = [dk_start]
    dk = math.ceil(dk_start / step) * step
    if abs(dk - dk_start) < 1e-6:
        dk += step
    while dk < dk_end - 1e-6:
        result.append(dk)
        dk += step
    result.append(dk_end)
    seen = set()
    unique = []
    for v in result:
        key = round(v, 6)
        if key not in seen:
            seen.add(key)
            unique.append(v)
    return sorted(unique)


